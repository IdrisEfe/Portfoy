# Optional: raises GitHub API rate limits for server-side requests.
GITHUB_TOKEN=

# Owner-only GitHub OAuth admin. Create an OAuth app with callback:
# http://localhost:3000/api/auth/github/callback (development)
SITE_URL=http://localhost:3000
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
ADMIN_GITHUB_USER_ID=
ADMIN_GITHUB_LOGIN=IdrisEfe
ADMIN_SESSION_SECRET=

# Repository used by the admin publisher.
GITHUB_CONTENT_OWNER=IdrisEfe
GITHUB_CONTENT_REPO=
GITHUB_CONTENT_BRANCH=main

# Explicit local-only admin bypass. Never enable in production.
ADMIN_DEV_BYPASS=false

# Contact and scheduling integrations will be connected later.
NEXT_PUBLIC_FILLOUT_FORM_ID=

# Owner-only analytics/admin integrations will be connected later.
NEXT_PUBLIC_ANALYTICS_SITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
UMAMI_API_BASE_URL=
UMAMI_API_KEY=
